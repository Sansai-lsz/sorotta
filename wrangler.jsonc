{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sorotta",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-bot",
      "database_id": "404f7ef2-a5c5-4283-8433-bb661dde7723",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "DISCORD_APP_ID": "1566303305217347646",
    "DISCORD_PUBLIC_KEY": "02784cfa7d15aa85a93da3dc45976dc8ea1df310c997f00cdf48098e21a9dcba",
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "secrets": {
    "required": ["DISCORD_BOT_TOKEN"],
  },
}
