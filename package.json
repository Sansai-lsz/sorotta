{
  "name": "game-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply game-bot --remote",
    "register": "node --env-file=.dev.vars scripts/register.ts",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "discord-api-types": "^0.38.57",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
